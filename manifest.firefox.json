{
  "manifest_version": 3,
  "name": "KingVamp",
  "version": "3.0.0",
  "description": "KingVamp by Roni — privacy-first userscript manager. Full GM API, advanced code editor with live linting, safety scanner, network monitor, and element picker. 100% local.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kingvamp@roni.dev",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/installDetect.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "notifications",
    "alarms",
    "downloads",
    "clipboardWrite",
    "contextMenus",
    "cookies"
  ],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "KingVamp"
  },
  "options_ui": {
    "page": "pages/dashboard.html",
    "open_in_tab": true
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open KingVamp Dashboard"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["pages/*", "assets/*", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}